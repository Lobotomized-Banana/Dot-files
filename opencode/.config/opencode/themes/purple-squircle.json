{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "bg0": "#0e0716",
    "bg1": "#160a21",
    "surf": "#1e0e2e",
    "surf2": "#2a1540",
    "fg": "#ece5f7",
    "mut": "#a898c2",
    "main": "#5b0ca6",
    "acc": "#490585",
    "hl": "#8b2fe0",
    "lav": "#c9a6ff",
    "act": "#a855f7",
    "red": "#ff5577",
    "redLt": "#ff7a93",
    "grn": "#7dd8a8",
    "yel": "#e8c47a",
    "cyn": "#7ab8e8",
    "wht": "#ffffff",
    "addBg": "#1a3a28",
    "remBg": "#3d1524",
    "lbg": "#f4effa",
    "lbg1": "#e9e0f5",
    "lelm": "#ded2f3",
    "lfg": "#2a1540",
    "lmut": "#6b5b85",
    "ladd": "#d9f2e3",
    "lrem": "#fbdfe7"
  },
  "theme": {
    "primary": { "dark": "main", "light": "main" },
    "secondary": { "dark": "hl", "light": "acc" },
    "accent": { "dark": "act", "light": "acc" },
    "error": { "dark": "red", "light": "red" },
    "warning": { "dark": "yel", "light": "yel" },
    "success": { "dark": "grn", "light": "grn" },
    "info": { "dark": "cyn", "light": "cyn" },
    "text": { "dark": "fg", "light": "lfg" },
    "textMuted": { "dark": "mut", "light": "lmut" },
    "background": { "dark": "bg0", "light": "lbg" },
    "backgroundPanel": { "dark": "bg1", "light": "lbg1" },
    "backgroundElement": { "dark": "surf", "light": "lelm" },
    "border": { "dark": "surf2", "light": "lav" },
    "borderActive": { "dark": "main", "light": "main" },
    "borderSubtle": { "dark": "surf", "light": "lelm" },
    "diffAdded": { "dark": "grn", "light": "grn" },
    "diffRemoved": { "dark": "red", "light": "red" },
    "diffContext": { "dark": "mut", "light": "lmut" },
    "diffHunkHeader": { "dark": "hl", "light": "acc" },
    "diffHighlightAdded": { "dark": "grn", "light": "grn" },
    "diffHighlightRemoved": { "dark": "red", "light": "red" },
    "diffAddedBg": { "dark": "addBg", "light": "ladd" },
    "diffRemovedBg": { "dark": "remBg", "light": "lrem" },
    "diffContextBg": { "dark": "bg1", "light": "lbg1" },
    "diffLineNumber": { "dark": "mut", "light": "textMuted" },
    "diffAddedLineNumberBg": { "dark": "addBg", "light": "ladd" },
    "diffRemovedLineNumberBg": { "dark": "remBg", "light": "lrem" },
    "markdownText": { "dark": "fg", "light": "lfg" },
    "markdownHeading": { "dark": "act", "light": "acc" },
    "markdownLink": { "dark": "cyn", "light": "acc" },
    "markdownLinkText": { "dark": "lav", "light": "acc" },
    "markdownCode": { "dark": "grn", "light": "grn" },
    "markdownBlockQuote": { "dark": "mut", "light": "lmut" },
    "markdownEmph": { "dark": "yel", "light": "yel" },
    "markdownStrong": { "dark": "wht", "light": "lfg" },
    "markdownHorizontalRule": { "dark": "surf2", "light": "lav" },
    "markdownListItem": { "dark": "hl", "light": "acc" },
    "markdownListEnumeration": { "dark": "cyn", "light": "cyn" },
    "markdownImage": { "dark": "hl", "light": "acc" },
    "markdownImageText": { "dark": "cyn", "light": "cyn" },
    "markdownCodeBlock": { "dark": "fg", "light": "lfg" },
    "syntaxComment": { "dark": "mut", "light": "lmut" },
    "syntaxKeyword": { "dark": "act", "light": "acc" },
    "syntaxFunction": { "dark": "hl", "light": "acc" },
    "syntaxVariable": { "dark": "yel", "light": "yel" },
    "syntaxString": { "dark": "grn", "light": "grn" },
    "syntaxNumber": { "dark": "lav", "light": "acc" },
    "syntaxType": { "dark": "cyn", "light": "cyn" },
    "syntaxOperator": { "dark": "redLt", "light": "red" },
    "syntaxPunctuation": { "dark": "fg", "light": "lfg" },
    "selectedListItemText": { "dark": "wht", "light": "wht" }
  }
}
