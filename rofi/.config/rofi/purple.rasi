/* Purple Squircle Rofi - #5b0ca6 / #490585 - rofi 2.0 syntax - all text pure white */
* {
  mybg:        rgba ( 14, 7, 22, 95% );
  mybg-alt:    rgba ( 30, 14, 46, 100% );
  mybg-select: rgba ( 91, 12, 166, 100% );
  mybg-accent: rgba ( 73, 5, 133, 100% );
  mywhite:     rgba ( 255, 255, 255, 100% );
  myborder:    rgba ( 91, 12, 166, 100% );

  /* Override rofi built-in fallbacks: dark bg everywhere, white text everywhere */
  background:                rgba ( 14, 7, 22, 95% );
  background-color:          transparent;
  foreground:                rgba ( 255, 255, 255, 100% );
  border-color:              rgba ( 91, 12, 166, 100% );
  separatorcolor:            rgba ( 42, 21, 64, 100% );
  scrollbar-handle:          rgba ( 91, 12, 166, 100% );
  normal-background:         rgba ( 14, 7, 22, 95% );
  normal-foreground:         rgba ( 255, 255, 255, 100% );
  alternate-normal-background: rgba ( 30, 14, 46, 100% );
  alternate-normal-foreground: rgba ( 255, 255, 255, 100% );
  selected-normal-background:  rgba ( 91, 12, 166, 100% );
  selected-normal-foreground:  rgba ( 255, 255, 255, 100% );
  urgent-background:         rgba ( 14, 7, 22, 95% );
  urgent-foreground:         rgba ( 255, 255, 255, 100% );
  selected-urgent-background:  rgba ( 91, 12, 166, 100% );
  selected-urgent-foreground:  rgba ( 255, 255, 255, 100% );
  alternate-urgent-background: rgba ( 30, 14, 46, 100% );
  alternate-urgent-foreground: rgba ( 255, 255, 255, 100% );
  active-background:         rgba ( 14, 7, 22, 95% );
  active-foreground:         rgba ( 255, 255, 255, 100% );
  selected-active-background:  rgba ( 91, 12, 166, 100% );
  selected-active-foreground:  rgba ( 255, 255, 255, 100% );
  alternate-active-background: rgba ( 30, 14, 46, 100% );
  alternate-active-foreground: rgba ( 255, 255, 255, 100% );
}

window {
  background-color: @mybg;
  border: 2px;
  border-color: @myborder;
  border-radius: 16px;
  width: 640px;
  padding: 16px;
}

mainbox {
  children: [ inputbar, listview ];
  spacing: 12px;
  background-color: transparent;
}

inputbar {
  children: [ prompt, entry ];
  background-color: @mybg-alt;
  border-radius: 12px;
  padding: 8px 12px;
  spacing: 8px;
}

prompt {
  text-color: @mywhite;
}

entry {
  text-color: @mywhite;
  placeholder: "Search apps…";
}

listview {
  lines: 9;
  columns: 1;
  spacing: 4px;
  scrollbar: true;
  fixed-height: true;
  background-color: transparent;
  border: 0px;
}

scrollbar {
  background-color: @mybg-alt;
  handle-color: @mybg-select;
  handle-width: 6px;
  border-radius: 6px;
}

message {
  background-color: @mybg-alt;
  text-color: @mywhite;
  border-radius: 10px;
  padding: 8px 12px;
}

textbox {
  background-color: transparent;
  text-color: @mywhite;
}

button {
  background-color: @mybg-alt;
  text-color: @mywhite;
  border-radius: 10px;
  padding: 6px 12px;
}

button selected.normal {
  background-color: @mybg-select;
  text-color: @mywhite;
}

mode-switcher {
  background-color: transparent;
  text-color: @mywhite;
  spacing: 6px;
}

element {
  background-color: transparent;
  text-color: @mywhite;
  border-radius: 10px;
  padding: 8px 12px;
  orientation: horizontal;
  spacing: 10px;
}

element-icon {
  size: 24px;
}

element-text {
  background-color: transparent;
  text-color: @mywhite;
  vertical-align: 0.5;
}

element normal.normal {
  background-color: transparent;
  text-color: @mywhite;
}

element alternate.normal {
  background-color: @mybg-alt;
  text-color: @mywhite;
}

element selected.normal {
  background-color: @mybg-select;
  border: 1px;
  border-color: @mybg-accent;
  text-color: @mywhite;
}

element normal.urgent, element alternate.urgent {
  background-color: transparent;
  text-color: @mywhite;
}

element selected.urgent {
  background-color: @mybg-select;
  text-color: @mywhite;
}

element normal.active, element alternate.active {
  background-color: transparent;
  text-color: @mywhite;
}

element selected.active {
  background-color: @mybg-select;
  text-color: @mywhite;
}
