#!/usr/bin/env bash
# rofi power menu - purple rice
# "Sign out" ends Hyprland and returns to the SDDM greeter (session picker).
set -euo pipefail
choice=$(printf "󰍃 Sign out to SDDM\n󰌾 Suspend\n Reboot\n⏻ Shutdown" | rofi -dmenu -p "Power" -theme ~/.config/rofi/purple.rasi)
case "$choice" in
  *Sign*) hyprctl dispatch exit ;;
  *Reboot*) systemctl reboot ;;
  *Shutdown*) systemctl poweroff ;;
  *Suspend*) systemctl suspend ;;
esac
