#!/usr/bin/env bash
# Set wallpaper via awww (swww fork) with fallback to hyprpaper
set -euo pipefail
IMG="${1:-$HOME/Pictures/purple-glow-3840x1080.png}"
if command -v awww >/dev/null; then
  pgrep -x awww-daemon >/dev/null || (awww-daemon & sleep 0.5)
  awww img "$IMG"
elif command -v swww >/dev/null; then
  pgrep -x swww-daemon >/dev/null || (swww-daemon & sleep 0.5)
  swww img "$IMG"
else
  echo "no awww/swww found, hyprpaper will use $IMG"
fi
